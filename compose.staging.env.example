# Copy to .env.staging next to compose.staging.yaml on the server.

POSTGRES_PASSWORD=generate-a-different-secret-than-production
POSTGRES_DB=wunschkonzert

# Required for docker compose (CI also exports these on deploy):
# BACKEND_IMAGE=registry.gitlab.com/YOUR_GROUP/YOUR_PROJECT/backend:dev
# FRONTEND_IMAGE=registry.gitlab.com/YOUR_GROUP/YOUR_PROJECT/frontend:dev

# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
# SPOTIFY_REDIRECT_URI=https://staging-wunschkonzert.jj11.ch/api/auth/spotify/callback

# Apple Music (optional):
# APPLE_MUSIC_TEAM_ID=...
# APPLE_MUSIC_KEY_ID=...
# APPLE_MUSIC_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
# APPLE_MUSIC_DEFAULT_STOREFRONT=us
