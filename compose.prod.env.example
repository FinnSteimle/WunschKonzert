# Copy to .env next to compose.prod.yaml on the server (never commit real .env).
# Image lines are optional here if you rely on the GitLab deploy job exporting them.
#
# Staging uses a separate directory (e.g. /opt/wunschkonzert-staging) with compose.staging.yaml
# and .env.staging. Prod Caddy and staging stacks share docker network wunschkonzert_edge
# (created automatically by deploy jobs, or: docker network create wunschkonzert_edge).

POSTGRES_PASSWORD=generate-a-long-random-secret
POSTGRES_DB=wunschkonzert

# Optional if deploy always passes these (CI sets them on each deploy):
# BACKEND_IMAGE=registry.gitlab.com/your-group/wunschkonzert/backend:main
# FRONTEND_IMAGE=registry.gitlab.com/your-group/wunschkonzert/frontend:main

# Required for Spotify (redirect must match your Spotify app settings):
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
# SPOTIFY_REDIRECT_URI=https://wunschkonzert.jj11.ch/api/auth/spotify/callback

# Apple Music (optional):
# APPLE_MUSIC_TEAM_ID=...
# APPLE_MUSIC_KEY_ID=...
# APPLE_MUSIC_PRIVATE_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
# APPLE_MUSIC_DEFAULT_STOREFRONT=us
